{
  "name": "portal-blackmagic",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/bvh.test.mjs && node --experimental-strip-types tests/optimizations.test.mjs",
    "test:prepare": "node tools/prepare-tests.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prebuild": "node tools/prepare-tests.mjs && node tools/build-gpu-check.mjs",
    "benchmark": "node --experimental-strip-types tests/benchmark.mjs",
    "test:egl": "npm run test:prepare && node tools/export-test-scenes.mjs && python tools/validate-egl.py",
    "test:browser": "npm run test:prepare && node tools/build-gpu-check.mjs && python tools/validate-browser.py"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
